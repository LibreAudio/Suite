{% block ImplementationDescription %}
// --------------------------------------------------------------------------------------------------------------------
// This file was generated using the Faust compiler (https://faust.grame.fr),
// and the Faust post-processor (https://github.com/SpotlightKid/faustdoctor).
//
// Source: {{filename}}
// Name: {{name}}
// Author: {{author}}
// License: {{license}}
// FAUST version: {{faustversion}}
// FAUST compilation options: {{meta.compile_options}}
// --------------------------------------------------------------------------------------------------------------------
{% endblock %}

{% block ImplementationPrologue %}
{% if fdrversioninfo is undefined or fdrversioninfo < (0, 2, 0) %}
{{fail("This template is not compatible with faustdoctor version < 0.2.0.")}}
{% endif %}
{% if not (id is defined and id == cid(id)) %}
{{fail("`id` is undefined or invalid.")}}
{% endif %}
{% endblock %}

#pragma once

#define FAUSTDR_BEGIN_NAMESPACE namespace {{id}} {
#define FAUSTDR_END_NAMESPACE }

{% block ImplementationIncludeHeader %}
#include "FaustDSP.hpp"
{% endblock %}
{% block ImplementationIncludeExtra %}
{% endblock %}

// --------------------------------------------------------------------------------------------------------------------
// faust generated code

{% block ImplementationFaustCode %}

{{ classcode
    | replace('#include <math.h>\n', '')
    | replace('\n\t\n', '\n\n')
    | replace('\t' + id + '() {', '\tfloat latency() const;\n\tfloat get(int) const;\n\n\tvoid set(int, float);\n\n\t' + id + '(){')
    | replace('\t', '    ')
    | replace(' : public dsp', '')
    | replace(' FAUSTDR_PRIVATE', 'private')
    | replace(' FAUSTDR_PROTECTED', 'protected')
    | replace('FAUSTDR_VIRTUAL ', '')
    | replace(', FAUSTFLOAT** RESTRICT inputs,', ', const FAUSTFLOAT* const* RESTRICT inputs,')
    | replace('  FAUSTFLOAT* input', '  const FAUSTFLOAT* input')
}}

{% endblock %}

FAUSTDR_BEGIN_NAMESPACE

// --------------------------------------------------------------------------------------------------------------------
// custom extensions to faust generated code

inline float {{id}}::get(int index) const
{
    switch (index) {
    {% for w in (active + passive) if w.symbol not in ["latency_samples"] %}
    case {{loop.index0}}:
        return {{w.varname}};
    {% endfor %}
    default:
        return 0.f;
    }
}

inline void {{id}}::set(int index, float value)
{
    switch (index) {
    {% for w in active %}
    case {{loop.index0}}:
        {{w.varname}} = value;
        break;
    {% endfor %}
    }
}

{% for w in passive if w.symbol == "latency_samples" %}
inline float {{id}}::latency() const
{
    return {{w.varname}};
}
{% endfor %}

// --------------------------------------------------------------------------------------------------------------------
// generate meta-data

enum Parameters {
    {% for w in (active + passive) if w.symbol not in ["latency_samples"] %}
    kParameter{{ w.symbol | title() }},
    {% endfor %}
    kParameterCount
};

static constexpr const uint32_t kNumInputs = {{inputs}};
static constexpr const uint32_t kNumOutputs = {{outputs}};
static constexpr const uint32_t kNumParametersActive = {{active|length}};
static constexpr const uint32_t kNumParametersPassive = {{passive|length - (1 if meta.latency_symbol is defined else 0)}};
static constexpr const uint32_t kNumParameters = kNumParametersActive + kNumParametersPassive;

static constexpr const FaustParameters<kNumParameters> kParameters = {
    {% for w in (active + passive) if w.symbol not in ["latency_samples"] %}
    {
        .label = "{{w.label}}",
        .symbol = "{{w.symbol}}",
        .tooltip = "{{w.tooltip}}",
        .unit = "{{w.unit}}",
        .init = {{w.init}},
        .min = {{w.min}},
        .max = {{w.max}},
        .step = {{w.step}},
        .isBoolean = {{ 'true' if w.type in ["button", "checkbox"] or w.meta.boolean is defined else 'false' }},
        .isInteger = {{ 'true' if w.type in ["button", "checkbox"] or w.meta.boolean is defined or w.meta.integer else 'false' }},
        .isLogarithmic = {{ 'true'  if w.scale == "log" else 'false' }},
        .isOutput = {{ 'true' if w in passive else 'false' }},
        .isTrigger = {{ 'true' if w.type == "button" or w.meta.trigger is defined else 'false' }},
    },
    {% endfor %}
};

// --------------------------------------------------------------------------------------------------------------------

FAUSTDR_END_NAMESPACE

// --------------------------------------------------------------------------------------------------------------------
// cleanup

#undef FAUSTDR_BEGIN_NAMESPACE
#undef FAUSTDR_END_NAMESPACE
#undef FAUSTCLASS
#undef RESTRICT

#ifdef __APPLE__
#undef exp10f
#undef exp10
#endif

