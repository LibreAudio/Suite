{% block ImplementationDescription %}
// --------------------------------------------------------------------------------------------------------------------
// This file was generated using the Faust compiler (https://faust.grame.fr),
// and the Faust post-processor (https://github.com/SpotlightKid/faustdoctor).
//
// Source: {{filename}}
// Name: {{name}}
// Author: {{author}}
// License: {{license}}
// FAUST version: {{faustversion}}
// FAUST compilation options: {{meta.compile_options}}
// --------------------------------------------------------------------------------------------------------------------
{% endblock %}

{% block HeaderPrologue %}
{% if fdrversioninfo is undefined or fdrversioninfo < (0, 2, 0) %}
{{fail("This template is not compatible with faustdoctor version < 0.2.0.")}}
{% endif %}
{% endblock %}

#pragma once

{% block ImplementationIncludeHeader %}
#include "FaustParameter.hpp"
{% endblock %}
{% block ImplementationIncludeExtra %}
{% endblock %}

#include <array>

namespace {{id}} {

enum FaustParameterList {
    {% for w in (active + passive) if w.symbol not in ["latency_samples"] %}
    kFaustParameter{{ w.symbol | title() }},
    {% endfor %}
    kFaustParameterCount
};

// FIXME this is too messy!
{% for w in passive if w.symbol == "latency_samples" %}
#define HIDDEN_PARAMS 1
{% endfor %}
#ifndef HIDDEN_PARAMS
#define HIDDEN_PARAMS 0
#endif

inline constexpr const uint32_t kNumInputs = {{inputs}};
inline constexpr const uint32_t kNumOutputs = {{outputs}};
inline constexpr const uint32_t kNumFaustParametersActive = {{active|length}};
inline constexpr const uint32_t kNumFaustParametersPassive = {{passive|length}} - HIDDEN_PARAMS;
static_assert(kNumFaustParametersActive + kNumFaustParametersPassive == kFaustParameterCount, "mismatch parameter count");

#undef HIDDEN_PARAMS

// FaustParameters<kFaustParameterCount>
inline constexpr const std::array<FaustParameter, kFaustParameterCount> kFaustParameters = {
{
    {% for w in (active + passive) if w.symbol not in ["latency_samples"] %}
    {
        .label = "{{w.label}}",
        .symbol = "{{w.symbol}}",
        .tooltip = "{{w.tooltip}}",
        .unit = "{{w.unit}}",
        .init = {{w.init}},
        .min = {{w.min}},
        .max = {{w.max}},
        .step = {{w.step}},
        .isBoolean = {{ 'true' if w.type in ["button", "checkbox"] or w.meta.boolean is defined else 'false' }},
        .isInteger = {{ 'true' if w.type in ["button", "checkbox"] or w.meta.boolean is defined or w.meta.integer else 'false' }},
        .isLogarithmic = {{ 'true'  if w.scale == "log" else 'false' }},
        .isOutput = {{ 'true' if w in passive else 'false' }},
        .isTrigger = {{ 'true' if w.type == "button" or w.meta.trigger is defined else 'false' }},
    },
    {% endfor %}
}};

}

{% block HeaderEpilogue %}
{% endblock %}
