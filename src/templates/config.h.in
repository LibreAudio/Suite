{% block HeaderDescription %}
//------------------------------------------------------------------------------
// This file was generated using the Faust compiler (https://faust.grame.fr),
// and the Faust post-processor (https://github.com/SpotlightKid/faustdoctor).
//
// Source: {{filename}}
// Name: {{name}}
// Author: {{author}}
// License: {{license}}
// FAUST version: {{faustversion}}
// FAUST compilation options: {{meta.compile_options}}
//------------------------------------------------------------------------------
{% endblock %}

{% block HeaderPrologue %}
{% if fdrversioninfo is undefined or fdrversioninfo < (0, 2, 0) %}
{{fail("This template is not compatible with faustdoctor version < 0.2.0.")}}
{% endif %}
{% endblock %}

#pragma once

#define DISTRHO_PLUGIN_CLAP_ID "org.libreaudio.{{id}}"
#define DISTRHO_PLUGIN_DESCRIPTION "{{meta.description}}"
#define DISTRHO_PLUGIN_LABEL "{{cid(id)}}"
#define DISTRHO_PLUGIN_NAME "LA {{name}}"
#define DISTRHO_PLUGIN_NUM_INPUTS {{inputs}}
#define DISTRHO_PLUGIN_NUM_OUTPUTS {{outputs}}
#define DISTRHO_PLUGIN_UNIQUE_ID {{meta.unique_id}}
#define DISTRHO_PLUGIN_URI "https://libreaudio.org/plugins/{{id}}"

// optional common IO
{% if id in ["adtDoubler", "adtDoubler_stereo"] %}
#define LIBREAUDIO_WANT_COMMON_IO 0
{% endif %}
#ifdef _DARKGLASS_DEVICE_PABLITO
#define LIBREAUDIO_WANT_COMMON_IO 0
#endif
#ifndef LIBREAUDIO_WANT_COMMON_IO
#define LIBREAUDIO_WANT_COMMON_IO 1
#endif

// optional time controls
{% for w in active if w.symbol == "dpf_bpm" %}
#define DISTRHO_PLUGIN_WANT_TIMEPOS 1
#define LIBREAUDIO_WANT_TIMEPOS_BPM 1
{% endfor %}
#ifndef LIBREAUDIO_WANT_TIMEPOS_BPM
#define LIBREAUDIO_WANT_TIMEPOS_BPM 0
#endif

// optional speech/voice-activity detection control
{% for w in active if w.symbol == "dpf_vad" %}
#define LIBREAUDIO_WANT_SPEECH_DETECTION 1
{% endfor %}
#ifndef LIBREAUDIO_WANT_SPEECH_DETECTION
#define LIBREAUDIO_WANT_SPEECH_DETECTION 0
#endif

// optional latency output
{% for w in passive if w.symbol == "latency_samples" %}
#define DISTRHO_PLUGIN_WANT_LATENCY 1
#define LIBREAUDIO_MAX_LATENCY_SAMPLES {{w.max|int}}
{% endfor %}
#ifndef DISTRHO_PLUGIN_WANT_LATENCY
#define DISTRHO_PLUGIN_WANT_LATENCY 0
#endif

// optional dry/wet control on top of main dsp
#define LIBREAUDIO_WANT_DRYWET {{1 if meta.drywet == "true" else 0}}

// optional UI graphs (fft analyzer, waveform, etc)
#ifdef LIBREAUDIO_CUSTOM_UI
{% if meta.graph is defined %}
#define LIBREAUDIO_WANT_GRAPH 1
    {% if meta.graph == "analyzer" %}
#define LIBREAUDIO_WANT_GRAPH_ANALYZER 1
#define LIBREAUDIO_WANT_GRAPH_WAVEFORM 0
#define LIBREAUDIO_WANT_GRAPH_IO_COUNT 1
    {% elif meta.graph == "waveform" %}
#define LIBREAUDIO_WANT_GRAPH_ANALYZER 0
#define LIBREAUDIO_WANT_GRAPH_WAVEFORM 1
#define LIBREAUDIO_WANT_GRAPH_IO_COUNT 1
    {% elif meta.graph == "waveform-stereo" %}
#define LIBREAUDIO_WANT_GRAPH_ANALYZER 0
#define LIBREAUDIO_WANT_GRAPH_WAVEFORM 1
#define LIBREAUDIO_WANT_GRAPH_IO_COUNT 2
    {% elif meta.graph == "waveform-gr" %}
// two values per point: the louder channel's peak, and the gain reduction from the "gr" meter (0..1 of its range)
#define LIBREAUDIO_WANT_GRAPH_ANALYZER 0
#define LIBREAUDIO_WANT_GRAPH_WAVEFORM 1
#define LIBREAUDIO_WANT_GRAPH_IO_COUNT 2
#define LIBREAUDIO_WANT_GRAPH_GR 1
    {% else %}
    {{fail("Invalid graph type")}}
    {% endif %}
{% endif %}
#endif
#ifndef LIBREAUDIO_WANT_GRAPH
#define LIBREAUDIO_WANT_GRAPH 0
#define LIBREAUDIO_WANT_GRAPH_ANALYZER 0
#define LIBREAUDIO_WANT_GRAPH_WAVEFORM 0
#define LIBREAUDIO_WANT_GRAPH_IO_COUNT 0
#endif
#ifndef LIBREAUDIO_WANT_GRAPH_GR
#define LIBREAUDIO_WANT_GRAPH_GR 0
#endif

// where the graph reads the audio: the plugin output (default), or the input right after the common input stage
{% if meta.graph_source is defined and meta.graph_source not in ["input", "output"] %}
{{fail("Invalid graph source")}}
{% endif %}
#define LIBREAUDIO_WANT_GRAPH_FROM_INPUT {{1 if meta.graph_source == "input" else 0}}

#define LIBREAUDIO_PLUGIN_DSP_INCLUDE "{{id}}-dsp.hpp"
#define LIBREAUDIO_PLUGIN_PARAMETERS_INCLUDE "{{id}}-parameters.hpp"
#define LIBREAUDIO_PLUGIN__{{cid(id)}}

namespace {{cid(id)}} {}
using namespace {{cid(id)}};

{% block HeaderEpilogue %}
{% endblock %}
